# Postgres. Production/Vercel: chuỗi kết nối Neon. Dev cục bộ không cần Neon: pglite:./.data/dev
DATABASE_URL=postgres://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# Better Auth: chuỗi ngẫu nhiên >= 32 ký tự (openssl rand -base64 32); URL gốc của app (rpID passkey lấy từ hostname)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Web Push (npx web-push generate-vapid-keys); VAPID_SUBJECT dạng mailto:ban@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Vercel Blob (ảnh minh chứng chuyển khoản)
BLOB_READ_WRITE_TOKEN=
