# Postgres. Production/Vercel: chuỗi kết nối Neon. Dev cục bộ không cần Neon: pglite:./.data/dev
DATABASE_URL=postgres://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# Better Auth: chuỗi ngẫu nhiên >= 32 ký tự (openssl rand -base64 32); URL gốc của app (rpID passkey lấy từ hostname)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Gửi email: mã OTP 6 số khi đăng ký và khi quên mật khẩu. Gmail SMTP + App Password (myaccount.google.com/apppasswords,
# cần bật xác minh 2 bước). SMTP_USER là địa chỉ Gmail gửi; SMTP_PASS là mật khẩu ứng dụng 16 ký tự (dấu cách được bỏ qua).
# Để trống: dev chỉ in thư ra console; production sẽ báo lỗi khi cần gửi thư. Tùy chọn: SMTP_HOST, SMTP_PORT, SMTP_FROM_NAME.
SMTP_USER=
SMTP_PASS=

# Đăng nhập bằng Google (tùy chọn; để trống thì ẩn nút Google). Google Cloud Console > APIs & Services > Credentials >
# Create OAuth client ID > Web application. Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
# (dev: http://localhost:3000/api/auth/callback/google; production: https://<tên-miền>/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web Push (npx web-push generate-vapid-keys); VAPID_SUBJECT dạng mailto:ban@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Vercel Blob (ảnh minh chứng chuyển khoản)
BLOB_READ_WRITE_TOKEN=
